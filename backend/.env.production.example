# Production env template — populate from your provider's secrets manager.
# Do NOT commit a filled-in version of this file.

ENVIRONMENT=production
DEBUG=false

# Supabase (or any managed Postgres + pgvector). Use the *transaction pooler*
# URL, swap "postgres://" prefix for "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME

# Upstash (or any managed Redis). Use the rediss:// (TLS) URL for Upstash.
REDIS_URL=rediss://default:PASS@HOST:6379

# Public URL of the deployed backend — used to build the embed snippet.
PUBLIC_BASE_URL=https://docupilot-backend.example.com

# Allowed origins for browser calls. JSON array.
# Include the dashboard origin AND any docs sites that embed the widget.
CORS_ORIGINS=["https://docupilot-dashboard.example.com"]

# Strong admin password — rotates ALL tokens when changed (signing key derives from it).
ADMIN_PASSWORD=replace-with-a-long-random-string

# Per-IP hashing salt. Any long random string; change invalidates prior hashes.
IP_HASH_SALT=replace-with-another-long-random-string

# Gemini
GEMINI_API_KEY=your-real-gemini-key

# Migrations are managed via Alembic in prod. Do NOT auto-create tables.
AUTO_CREATE_TABLES=false
